# 正式環境設定範本
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# .env.prod 已被 .gitignore 排除，絕對不要 commit。
# 注意：init_env.py 只服務開發用的 .env，不會產生這個檔案，以下全部要手動填。

# ── 資料庫 ────────────────────────────────────────────────
# 正式環境請用夠長的隨機密碼：openssl rand -base64 24
POSTGRES_USER=dramaradar
POSTGRES_PASSWORD=
POSTGRES_DB=dramaradar

# DATABASE_URL 不用填，docker-compose.prod.yml 會依上面三個值自動組出來

# ── Airflow ──────────────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.com

# 加密 Connection / Variable 用，開發環境是空的，正式環境一定要給。
# 產生：docker run --rm apache/airflow:3.3.0-python3.12 \
#         python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# 產生：openssl rand -hex 32
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=

# 有掛網域或反向代理時改成對外網址，例如 https://airflow.example.com
AIRFLOW_BASE_URL=http://localhost:8080

# 同時執行的 task 數量上限，直接決定記憶體用量（每個 task process 約 300MB）。
# 8GB 機型（e2-standard-2）用預設 6；4GB 機型（e2-medium）請改成 3。
AIRFLOW_PARALLELISM=6
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=6

# ── 第三方 API 金鑰 ───────────────────────────────────────
GEMINI_API_KEY=
APIFY_STORE=
APIFY_REVIEW=
THREADS_API_KEY=
THREADS_LONG_KEY=
THREADS_USER_ID=
